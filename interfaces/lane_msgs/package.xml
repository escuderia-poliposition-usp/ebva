<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>lane_msgs</name>
  <version>0.0.1</version>
  <description>Mensagem custom com as duas sequências de pontos das faixas (esquerda/direita) no referencial da câmera, para o nó lane_perception.</description>
  <maintainer email="ebva.usp@gmail.com">Francisco</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
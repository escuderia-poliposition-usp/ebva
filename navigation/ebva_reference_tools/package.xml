<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>ebva_reference_tools</name>
  <version>0.0.0</version>
  <description>Coleta, geração e publicação de referências.</description>
  <maintainer email="ebva.usp@gmail.com">poliposition</maintainer>
  <license>MIT</license>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>ebva_lane_detection</name>
  <version>0.0.1</version>
  <description>Nó ROS 2 de segmentação de faixas (OpenCV) para lane keeping: converte a imagem da câmera em vista de pássaro e publica as faixas esquerda/direita no referencial da câmera.</description>
  <maintainer email="ebva.usp@gmail.com">Francisco</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>lane_msgs</depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>rosbag2_interfaces</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
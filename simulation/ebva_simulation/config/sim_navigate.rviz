Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane Cell Count: 20
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Value: true
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Color Scheme: map
      Alpha: 0.8
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Reference Path
      Topic:
        Value: /reference_path
        Durability Policy: Transient Local
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.03
      Value: true
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Robot Pose
      Topic:
        Value: /robot_pose
        Durability Policy: Volatile
      Shape: Arrow
      Color: 255; 25; 0
      Axes Length: 0.4
      Axes Radius: 0.05
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 60
      Target Frame: map
      X: 2
      Y: 2
Window Geometry:
  Height: 900
  Width: 1400
  X: 50
  Y: 50

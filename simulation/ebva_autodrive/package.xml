<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>ebva_autodrive</name>
  <version>0.1.0</version>
  <description>Integração ROS e teleop do simulador AutoDRIVE.</description>
  <license>BSD-2-Clause AND MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <maintainer email="ebva.usp@gmail.com">Poliposition</maintainer>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-gevent</exec_depend>
  <exec_depend>python3-socketio</exec_depend>
  <test_depend>python3-pytest</test_depend>
</package>